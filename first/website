<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Website Structure</title>
</head>
<body>

  <!-- Navbar -->
  <nav class="flex justify-between bg-blue-400">
    <h1 class="font-bold mt-4 text-2xl">My Website</h1>

    <ul class="flex gap-4 p-6">
      <li class="font-bold text-2xl hover:bg-yellow-400"><a href="#">Home</a></li>
      <li class="font-bold text-2xl hover:bg-red-400"><a href="#">About</a></li>
      <li class="font-bold text-2xl hover:bg-green-400"><a href="#">Contact</a></li>
    </ul>
  </nav>

  <!-- Hero Section -->
  <section class="text-center bg-green-400 p-6 mt-4">
    <h2 class="font-bold">Learn Tailwind CSS</h2>

    <p class="mt-4">
      Practice Flexbox, Grid, Cards, Buttons and more
    </p>

    <button class="border-2 mt-4 p-3 bg-purple-400 font-bold rounded-full">Get Started</button>
  </section>

  <!-- Cards Section -->
  <section class="flex gap-4 bg-yellow-300 p-6 mt-4">

    <div class="bg-green-400 p-2">
      <h3 class="font-bold text-center">Card 1</h3>
      <p class="mt-3">
        This is a simple Tailwind card design.
      </p>
      <button class="border-2 p-1 mt-3 ml-12">Read More</button>
    </div>

    <div class="bg-green-400 p-2">
      <h3 class="font-bold text-center">Card 2</h3>
      <p class="mt-3">
        Practice grid and spacing utilities.
      </p>
      <button class="border-2 p-1 mt-3 ml-12">Explore</button>
    </div>

    <div class="bg-green-400 p-2">
      <h3 class="font-bold text-center">Card 3</h3>
      <p class="mt-3">
        Learn hover, padding and responsive classes.
      </p>
      <button class="border-2 p-1 mt-3 ml-12">Click Here</button>
    </div>

  </section>

  <!-- Footer -->
  <footer class="text-center bg-gray-400 p-6 mt-4">
    <p class="font-black">© 2026 Tailwind Practice Website</p>
  </footer>

</body>
</html>
